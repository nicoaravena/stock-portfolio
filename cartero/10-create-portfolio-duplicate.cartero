# Expect: 409 Portfolio main already exists
version = 1
url = "{{BASE_URL}}/portfolios"
method = "POST"

[headers]
Content-Type = "application/json"

[body]
type = "raw"
format = "json"
body = """
{
  "name": "main",
  "holdings": [
    {
      "symbol": "META",
      "quantity": 2,
      "allocation": 40
    },
    {
      "symbol": "AAPL",
      "allocation": 60
    }
  ],
  "cash_leftover": "0"
}"""

[variables]
BASE_URL = "http://127.0.0.1:8000/api"
PORTFOLIO_ID = "1"
