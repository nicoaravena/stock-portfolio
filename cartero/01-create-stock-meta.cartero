# Expect: 201, symbol normalized to META
version = 1
url = "{{BASE_URL}}/stocks"
method = "POST"

[headers]
Content-Type = "application/json"

[body]
type = "raw"
format = "json"
body = """
{
  "symbol": "meta",
  "last_price": "500"
}"""

[variables]
BASE_URL = "http://127.0.0.1:8000/api"
PORTFOLIO_ID = "1"
