# Expect: 422 cash must not be greater ...
version = 1
url = "{{BASE_URL}}/portfolios/{{PORTFOLIO_ID}}/rebalance"
method = "POST"

[headers]
Content-Type = "application/json"

[body]
type = "raw"
format = "json"
body = """
{
  "cash": "-100000"
}"""

[variables]
BASE_URL = "http://127.0.0.1:8000/api"
PORTFOLIO_ID = "1"
